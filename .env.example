# GitHub 配置
GITHUB_TOKEN=你的GitHub个人访问令牌
GITHUB_WEBHOOK_SECRET=你的Webhook密钥
GITHUB_REPO_OWNER=lialexc
GITHUB_REPO_NAME=cozeli

# Coze 配置
COZE_API_KEY=你的Coze API密钥
COZE_BOT_ID=你的Coze机器人ID
COZE_WORKSPACE_ID=你的Coze工作空间ID

# 服务器配置
PORT=3000
NODE_ENV=development
WEBHOOK_URL=你的Webhook地址

# 数据库配置（可选）
MONGODB_URI=mongodb://localhost:27017/cozeli
REDIS_URL=redis://localhost:6379

# 日志级别
LOG_LEVEL=info